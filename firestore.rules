rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    // Just a placeholder since we don't have admins setup yet
    // Alternatively, verify email or set it later.
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /settings/{settingId} {
      // Anyone can read config to load the CSV URL
      allow read: if true;
      // Only admins can write config
      // allow write: if isAdmin();
      // For now, allow writes from anyone so they can test if they don't have an admin dashboard yet?
      // No, for security, let's restrict to admins or just isSignedIn for now?
      // Or require signed in users to write. 
      allow write: if isSignedIn() && request.auth.token.email_verified == true;
    }

    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
